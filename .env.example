MYSQL_ROOT_PASSWORD=change_this_mysql_root_password
MYSQL_DATABASE=drop_ai
MYSQL_USER=dropai
MYSQL_PASSWORD=change_this_mysql_password

SERVER_PORT=8080
DOKIAI_TOMCAT_NIO2_ENABLED=false
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/drop_ai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change_this_mysql_password

DOUBAO_API_KEY=your_doubao_ark_api_key
DOUBAO_MODEL=doubao-seed-2-1-260628
DOUBAO_TEXT_MODEL=doubao-seed-2-1-turbo-260628
DOUBAO_REVIEW_MODEL=doubao-seed-2-1-pro-260628
DOUBAO_FALLBACK_MODEL=doubao-seed-2-0-lite-260428
DOUBAO_VISION_MODEL=
DOUBAO_MECHANICAL_VISION_MODEL=doubao-seed-2-1-turbo-260628
DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_DOCUMENT_CONCURRENCY=8
DOUBAO_WEB_SEARCH_ENABLED=false
DOUBAO_WEB_SEARCH_MODEL=doubao-seed-2-1-turbo-260628
DOUBAO_RESPONSES_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_RESPONSES_PATH=/responses
DOUBAO_WEB_SEARCH_TIMEOUT_SECONDS=60
DOUBAO_WEB_SEARCH_MAX_RESULTS=30
DOUBAO_WEB_SEARCH_RETRY_COUNT=2
DOUBAO_WEB_SEARCH_MAX_QUERIES=12
DOUBAO_MAX_RETRIES=2

WRITING_REFERENCE_SEARCH_ENABLED=true
WRITING_REFERENCE_SEARCH_PROVIDER=doubao_web
WRITING_REFERENCE_SEARCH_MAX_RESULTS=30
WRITING_REFERENCE_SEARCH_TIMEOUT_SECONDS=30
WRITING_REFERENCE_SEARCH_RETRY_COUNT=3
WRITING_MAX_RETRY=3
WRITING_CHAPTER_TIMEOUT=180

# Dokiai Presentation Studio (do not commit real keys)
DOKIAI_PPT_ENABLED=true
DOKIAI_PPT_PROVIDER=kimi_ark
DOKIAI_PPT_ARK_API_KEY=
DOKIAI_PPT_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOKIAI_PPT_RESPONSES_PATH=/responses
DOKIAI_PPT_KIMI_MODEL=
DOKIAI_PPT_KIMI_ENDPOINT_ID=
DOKIAI_PPT_TIMEOUT_SECONDS=300
DOKIAI_PPT_MAX_RETRIES=2
DOKIAI_PPT_MAX_SLIDES=40
DOKIAI_PPT_FONT_FILES=400=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc,500=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc,600=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc,700=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc
DOKIAI_GIT_COMMIT=

# Word template-driven formatter. The source document must be DOCX; templates
# may be DOC, DOCX, or DOTX. Legacy DOC conversion requires Microsoft Word on Windows.
WORD_FORMAT_ENABLED=true
WORD_FORMAT_PYTHON=python
WORD_FORMAT_WORKER=document-format-tool/format_cli.py
WORD_FORMAT_DATA_DIR=storage/word-format
WORD_FORMAT_MAX_SOURCE_BYTES=104857600
WORD_FORMAT_MAX_TEMPLATE_BYTES=31457280
WORD_FORMAT_LEGACY_TEMPLATES_ENABLED=
WORD_FORMAT_MAX_EXPANDED_BYTES=1073741824
WORD_FORMAT_MAX_INSTRUCTIONS_CHARS=20000
WORD_FORMAT_TIMEOUT_SECONDS=600
WORD_FORMAT_MAX_CONCURRENT=1
WORD_FORMAT_QUEUE_CAPACITY=20

OPENALEX_SEARCH_ENABLED=false
OPENALEX_API_KEY=

CROSSREF_SEARCH_ENABLED=false
CROSSREF_MAILTO=
CROSSREF_API_TOKEN=

DIAGRAM_PYTHON=python
DIAGRAM_WORKER=diagram-worker/web_engine.py
DIAGRAM_ARTIFACT_ROOT=data/diagram-previews
DOUBAO_DIAGRAM_MODEL=doubao-seed-2-1-turbo-260628
DOUBAO_DIAGRAM_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions

MATRIX_API_KEY=your_matrix_api_key
MATRIX_MODEL=claude-opus-4-7
MATRIX_ENDPOINT=https://www.aikeys.me/v1/chat/completions
MATRIX_DESIGN_ENABLED=true

APP_BASE_URL=https://dropai-demo.com
EPAY_GATEWAY=https://pay.dropai-demo.com/submit.php
EPAY_PID=replace_with_merchant_id
EPAY_KEY=replace_with_merchant_secret
EPAY_NOTIFY_URL=https://dropai-demo.com/api/recharge/notify
EPAY_RETURN_URL=https://dropai-demo.com/recharge
EPAY_SITE_NAME=DropAI
EPAY_DEFAULT_TYPE=alipay
EPAY_QUERY_URL=https://pay.dropai-demo.com/api.php
EPAY_MOCK_ENABLED=false
