      "recommended_status_text": "正在渲染图形…"
    },
    "success": {
      "label": "生成完成",
      "png": "png/assistant_success.png",
      "webp": "webp/assistant_success.webp",
      "fallback": "png/06_生成完成.png",
      "recommended_status_text": "生成完成"
    },
    "error": {
      "label": "异常",
      "png": "png/assistant_error.png",
      "webp": "webp/assistant_error.webp",
      "fallback": "png/07_异常.png",
      "recommended_status_text": "生成失败，请重试"
