{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EngineeringDrawing",
  "type": "object",
  "required": [
    "name",
    "standard",
    "views",
    "dimensions",
    "datum",
    "tolerance",
    "technicalRequirements",
    "bom",
    "material"
  ],
  "properties": {
    "name": { "type": "string" },
    "standard": {
      "type": "string",
      "enum": ["GB/T", "ISO", "GB/T+ISO"]
    },
    "views": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "enum": ["front", "top", "side", "section", "isometric", "detail"]
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "string"]
      }
    },
    "datum": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "A" }
    },
    "tolerance": {
      "type": "object",
      "required": ["general"],
      "properties": {
        "general": { "type": "string" },
        "geometric": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "technicalRequirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "bom": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "quantity"],
        "properties": {
          "name": { "type": "string" },
          "material": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "material": { "type": "string" }
  }
}
