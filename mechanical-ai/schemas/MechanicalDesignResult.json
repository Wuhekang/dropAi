    "structureTree": { "type": "object" },
    "parts": { "type": "array", "items": { "type": "object" } },
    "assembly": { "type": "object" },
    "cadFeatures": { "type": "array", "items": { "type": "object" } },
    "drawings": { "type": "object" },
    "bom": { "type": "array", "items": { "type": "object" } },
