<script setup lang="ts">import{onMounted,reactive,ref}from'vue';import{page${entity.className},create${entity.className},update${entity.className},delete${entity.className}}from'../../api/${entity.variableName}';<#if entity.parentRelation??>import{options${entity.parentRelation.sourceEntity}}from'../../api/${entity.parentRelation.sourceEntity?uncap_first}';</#if>import type{${entity.className}VO}from'../../types/${entity.variableName}';const rows=ref<${entity.className}VO[]>([]);const dialog=ref(false);const form=reactive<any>({});<#if entity.parentRelation??>const relationOptions=ref<Array<{id:number,label:string}>>([]);</#if>async function load(){rows.value=(await page${entity.className}({pageNum:1,pageSize:20})).data.data.records<#if entity.parentRelation??>;relationOptions.value=(await options${entity.parentRelation.sourceEntity}()).data.data</#if>}function add(){Object.keys(form).forEach(k=>delete form[k]);dialog.value=true}function edit(row:any){Object.assign(form,row);dialog.value=true}async function save(){form.id?await update${entity.className}(form):await create${entity.className}(form);dialog.value=false;await load()}async function remove(id:number){await delete${entity.className}(id);await load()}onMounted(load)</script>
<template><div style="padding:24px"><h1>${entity.title}管理</h1><el-button type="primary" @click="add">新增</el-button><el-table :data="rows"><#list entity.fields as field><#if field.listVisible && field.name != "deleted" && !field.relationField><el-table-column prop="${field.name}" label="${field.title}"/></#if></#list><#if entity.parentRelation??><el-table-column prop="${entity.parentRelation.displayProperty}" label="${entity.parentRelation.sourceEntity}"/></#if><el-table-column label="操作"><template #default="s"><el-button @click="edit(s.row)">编辑</el-button><el-button type="danger" @click="remove(s.row.id)">删除</el-button></template></el-table-column></el-table><el-dialog v-model="dialog" title="${entity.title}"><#list entity.fields as field><#if field.formVisible><el-form-item label="${field.title}"><#if field.relationField><el-select v-model="form.${field.name}" placeholder="请选择${field.title}"><el-option v-for="option in relationOptions" :key="option.id" :label="option.label" :value="option.id"/></el-select><#else><el-input v-model="form.${field.name}"/></#if></el-form-item></#if></#list><el-button type="primary" @click="save">保存</el-button></el-dialog></div></template>
