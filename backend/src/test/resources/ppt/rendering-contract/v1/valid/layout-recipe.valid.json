{
  "schemaVersion": "layout-recipe.v1",
  "layoutId": "image-proof-screenshot-wide.v1",
  "layoutVersion": "1.0.0",
  "supports": {
    "pageTypes": ["IMAGE"],
    "pagePurposes": ["IMPLEMENTATION", "RESULT"],
    "contentTypes": ["FIGURE"],
    "imageRoles": ["PROOF"],
    "assetKinds": ["SCREENSHOT"],
    "tableKinds": [],
    "assetCount": { "min": 1, "max": 1 }
  },
  "slots": {
    "title": { "gridColumn": 1, "gridSpan": 10, "topIn": 0.42, "heightIn": 0.62 },
    "image": { "gridColumn": 1, "gridSpan": 8, "topIn": 1.28, "heightIn": 5.45 },
    "caption": { "gridColumn": 9, "gridSpan": 4, "topIn": 1.62, "heightIn": 3.3 },
    "conclusion": { "gridColumn": 9, "gridSpan": 4, "topIn": 5.2, "heightIn": 1.1 }
  },
  "constraints": {
    "titleMaxLines": 2,
    "bodyMaxChars": 180,
    "captionMaxChars": 90,
    "imageFit": "CONTAIN",
    "cropAllowed": false,
    "minImageAreaRatio": 0.52
  },
  "fallbacks": ["image-diagram-with-notes.v1"]
}
