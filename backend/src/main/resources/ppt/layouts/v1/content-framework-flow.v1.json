{
  "schemaVersion": "layout-recipe.v1",
  "layoutId": "content-framework-flow.v1",
  "layoutVersion": "1.0.0",
  "supports": {
    "pageTypes": ["CONTENT"],
    "pagePurposes": ["DESIGN", "BACKGROUND", "RESULT"],
    "contentTypes": ["ARCHITECTURE"],
    "imageRoles": [], "assetKinds": [], "tableKinds": [],
    "assetCount": { "min": 0, "max": 0 }
  },
  "slots": {
    "title": { "gridColumn": 1, "gridSpan": 12, "topIn": 0.4, "heightIn": 0.7 },
    "keyPoints": { "gridColumn": 2, "gridSpan": 10, "topIn": 1.42, "heightIn": 4.3 },
    "conclusion": { "gridColumn": 2, "gridSpan": 10, "topIn": 5.88, "heightIn": 0.72 },
    "footer": { "gridColumn": 1, "gridSpan": 12, "topIn": 6.85, "heightIn": 0.25 }
  },
  "constraints": {
    "titleMaxLines": 1, "bodyMaxChars": 360, "captionMaxChars": 0,
    "imageFit": "CONTAIN", "cropAllowed": false, "minImageAreaRatio": 0,
    "allowedContainedTextComponents": ["keyPointCard", "summaryCard"]
  },
  "fallbacks": ["content-architecture-layers.v1", "content-single-insight.v1"]
}
