{
  "schemaVersion": "layout-recipe.v1",
  "layoutId": "content-comparison-columns.v1",
  "layoutVersion": "1.1.0",
  "supports": {
    "pageTypes": ["CONTENT"],
    "pagePurposes": ["BACKGROUND", "PROBLEM", "METHOD", "DESIGN", "RESULT", "TEST", "SUMMARY"],
    "contentTypes": ["COMPARISON", "METRICS"],
    "imageRoles": [],
    "assetKinds": [],
    "tableKinds": [],
    "assetCount": { "min": 0, "max": 0 }
  },
  "slots": {
    "title": { "gridColumn": 1, "gridSpan": 12, "topIn": 0.4, "heightIn": 0.7 },
    "body": { "gridColumn": 1, "gridSpan": 5, "topIn": 1.55, "heightIn": 4.05 },
    "keyPoints": { "gridColumn": 8, "gridSpan": 5, "topIn": 1.55, "heightIn": 4.05 },
    "conclusion": { "gridColumn": 2, "gridSpan": 10, "topIn": 5.85, "heightIn": 0.72 },
    "footer": { "gridColumn": 1, "gridSpan": 12, "topIn": 6.85, "heightIn": 0.25 }
  },
  "constraints": {
    "titleMaxLines": 1,
    "bodyMaxChars": 240,
    "captionMaxChars": 0,
    "imageFit": "CONTAIN",
    "cropAllowed": false,
    "minImageAreaRatio": 0,
    "allowedContainedTextComponents": ["keyPointCard"]
  },
  "fallbacks": ["content-single-insight.v1"]
}
