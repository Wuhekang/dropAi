{
  "schemaVersion": "layout-recipe.v1",
  "layoutId": "content-comparison-columns.v1",
  "layoutVersion": "1.0.0",
  "supports": {
    "pageTypes": ["CONTENT"],
    "pagePurposes": ["PROBLEM", "METHOD", "DESIGN", "RESULT", "TEST"],
    "contentTypes": ["COMPARISON", "METRICS"],
    "imageRoles": [],
    "assetKinds": [],
    "tableKinds": [],
    "assetCount": { "min": 0, "max": 0 }
  },
  "slots": {
    "title": { "gridColumn": 1, "gridSpan": 12, "topIn": 0.4, "heightIn": 0.7 },
    "body": { "gridColumn": 1, "gridSpan": 6, "topIn": 1.55, "heightIn": 4.7 },
    "keyPoints": { "gridColumn": 7, "gridSpan": 6, "topIn": 1.55, "heightIn": 4.7 },
    "conclusion": { "gridColumn": 2, "gridSpan": 10, "topIn": 6.38, "heightIn": 0.4 },
    "footer": { "gridColumn": 1, "gridSpan": 12, "topIn": 6.9, "heightIn": 0.2 }
  },
  "constraints": {
    "titleMaxLines": 1,
    "bodyMaxChars": 240,
    "captionMaxChars": 0,
    "imageFit": "CONTAIN",
    "cropAllowed": false,
    "minImageAreaRatio": 0,
    "allowedContainedTextComponents": ["keyPointCard"]
  },
  "fallbacks": ["content-single-insight.v1"]
}
