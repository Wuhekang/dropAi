{
  "schemaVersion": "layout-recipe.v1",
  "layoutId": "image-effect-full-visual.v1",
  "layoutVersion": "1.2.0",
  "supports": {
    "pageTypes": ["IMAGE"],
    "pagePurposes": ["IMPLEMENTATION", "RESULT"],
    "contentTypes": ["FIGURE", "MIXED"],
    "imageRoles": ["EFFECT"],
    "assetKinds": ["PHOTO", "DESIGN_RENDER", "SCREENSHOT"],
    "tableKinds": [],
    "assetCount": { "min": 1, "max": 1 }
  },
  "slots": {
    "title": { "gridColumn": 1, "gridSpan": 12, "topIn": 0.4, "heightIn": 0.7 },
    "image": { "gridColumn": 1, "gridSpan": 12, "topIn": 1.2, "heightIn": 3.85 },
    "body": { "gridColumn": 1, "gridSpan": 12, "topIn": 5.18, "heightIn": 0.8 },
    "caption": { "gridColumn": 1, "gridSpan": 12, "topIn": 6.08, "heightIn": 0.62 },
    "footer": { "gridColumn": 1, "gridSpan": 12, "topIn": 6.85, "heightIn": 0.25 }
  },
  "constraints": {
    "titleMaxLines": 1,
    "bodyMaxChars": 100,
    "captionMaxChars": 70,
    "captionMaxLines": 2,
    "imageFit": "CONTAIN",
    "cropAllowed": false,
    "minImageAreaRatio": 0.7
  },
  "fallbacks": ["image-centered-caption-bottom.v1"]
}
