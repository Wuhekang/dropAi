{
  "schemaVersion": "layout-recipe.v1",
  "layoutId": "image-effect-full-visual.v1",
  "layoutVersion": "1.0.0",
  "supports": {
    "pageTypes": ["IMAGE"],
    "pagePurposes": ["IMPLEMENTATION", "RESULT"],
    "contentTypes": ["FIGURE", "MIXED"],
    "imageRoles": ["EFFECT"],
    "assetKinds": ["PHOTO", "DESIGN_RENDER", "SCREENSHOT"],
    "tableKinds": [],
    "assetCount": { "min": 1, "max": 1 }
  },
  "slots": {
    "title": { "gridColumn": 1, "gridSpan": 12, "topIn": 0.4, "heightIn": 0.7 },
    "image": { "gridColumn": 1, "gridSpan": 12, "topIn": 1.25, "heightIn": 5.5 },
    "caption": { "gridColumn": 2, "gridSpan": 10, "topIn": 6.8, "heightIn": 0.3 }
  },
  "constraints": {
    "titleMaxLines": 1,
    "bodyMaxChars": 100,
    "captionMaxChars": 70,
    "imageFit": "CONTAIN",
    "cropAllowed": false,
    "minImageAreaRatio": 0.7
  },
  "fallbacks": []
}
