{
  "schemaVersion": "layout-recipe.v1",
  "layoutId": "content-architecture-layers.v1",
  "layoutVersion": "1.0.0",
  "supports": {
    "pageTypes": ["CONTENT"],
    "pagePurposes": ["METHOD", "DESIGN", "DATABASE", "IMPLEMENTATION"],
    "contentTypes": ["ARCHITECTURE"],
    "imageRoles": [],
    "assetKinds": [],
    "tableKinds": [],
    "assetCount": { "min": 0, "max": 0 }
  },
  "slots": {
    "title": { "gridColumn": 1, "gridSpan": 12, "topIn": 0.4, "heightIn": 0.7 },
    "keyPoints": { "gridColumn": 1, "gridSpan": 12, "topIn": 1.45, "heightIn": 4.5 },
    "conclusion": { "gridColumn": 2, "gridSpan": 10, "topIn": 6.12, "heightIn": 0.68 },
    "footer": { "gridColumn": 1, "gridSpan": 12, "topIn": 6.9, "heightIn": 0.2 }
  },
  "constraints": {
    "titleMaxLines": 1,
    "bodyMaxChars": 220,
    "captionMaxChars": 0,
    "imageFit": "CONTAIN",
    "cropAllowed": false,
    "minImageAreaRatio": 0,
    "allowedContainedTextComponents": ["keyPointCard"]
  },
  "fallbacks": ["content-single-insight.v1"]
}
