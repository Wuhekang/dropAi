  "slots": {
    "title": { "gridColumn": 1, "gridSpan": 12, "topIn": 0.4, "heightIn": 0.7 },
    "keyPoints": { "gridColumn": 1, "gridSpan": 12, "topIn": 1.48, "heightIn": 3.92 },
    "conclusion": { "gridColumn": 2, "gridSpan": 10, "topIn": 5.58, "heightIn": 0.98 },
    "footer": { "gridColumn": 1, "gridSpan": 12, "topIn": 6.85, "heightIn": 0.25 }
