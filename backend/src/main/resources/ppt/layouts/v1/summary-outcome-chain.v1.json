  "constraints": {
    "titleMaxLines": 1, "bodyMaxChars": 420, "captionMaxChars": 0,
    "imageFit": "CONTAIN", "cropAllowed": false, "minImageAreaRatio": 0,
    "allowedContainedTextComponents": ["keyPointCard", "summaryCard"]
