{
  "schemaVersion": "layout-recipe.v1",
  "layoutId": "content-three-cards.v1",
  "layoutVersion": "1.0.0",
  "supports": {
    "pageTypes": ["CONTENT"],
    "pagePurposes": ["BACKGROUND", "PROBLEM", "METHOD", "DESIGN", "IMPLEMENTATION", "RESULT", "TEST", "SUMMARY"],
    "contentTypes": ["KEY_POINTS", "COMPARISON", "METRICS"],
    "imageRoles": [],
    "assetKinds": [],
    "tableKinds": [],
    "assetCount": { "min": 0, "max": 0 }
  },
  "slots": {
    "title": { "gridColumn": 1, "gridSpan": 12, "topIn": 0.4, "heightIn": 0.7 },
    "keyPoints": { "gridColumn": 1, "gridSpan": 12, "topIn": 1.52, "heightIn": 3.75 },
    "conclusion": { "gridColumn": 2, "gridSpan": 10, "topIn": 5.55, "heightIn": 0.9 },
    "footer": { "gridColumn": 1, "gridSpan": 12, "topIn": 6.85, "heightIn": 0.25 }
  },
  "constraints": {
    "titleMaxLines": 1,
    "bodyMaxChars": 220,
    "captionMaxChars": 0,
    "imageFit": "CONTAIN",
    "cropAllowed": false,
    "minImageAreaRatio": 0,
    "allowedContainedTextComponents": ["keyPointCard"]
  },
  "fallbacks": ["content-single-insight.v1"]
}
