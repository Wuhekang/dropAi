{
  "schemaVersion": "layout-recipe.v1",
  "layoutId": "content-single-insight.v1",
  "layoutVersion": "1.0.0",
  "supports": {
    "pageTypes": ["CONTENT"],
    "pagePurposes": ["BACKGROUND", "PROBLEM", "METHOD", "DESIGN", "DATABASE", "IMPLEMENTATION", "RESULT", "TEST", "SUMMARY"],
    "contentTypes": ["NARRATIVE", "KEY_POINTS", "PROCESS", "COMPARISON", "ARCHITECTURE", "METRICS", "MIXED"],
    "imageRoles": [],
    "assetKinds": [],
    "tableKinds": [],
    "assetCount": { "min": 0, "max": 0 }
  },
  "slots": {
    "title": { "gridColumn": 1, "gridSpan": 12, "topIn": 0.4, "heightIn": 0.7 },
    "body": { "gridColumn": 2, "gridSpan": 10, "topIn": 1.52, "heightIn": 3.25 },
    "conclusion": { "gridColumn": 2, "gridSpan": 10, "topIn": 5.15, "heightIn": 1.2 },
    "footer": { "gridColumn": 1, "gridSpan": 12, "topIn": 6.85, "heightIn": 0.25 }
  },
  "constraints": {
    "titleMaxLines": 1,
    "bodyMaxChars": 260,
    "captionMaxChars": 0,
    "imageFit": "CONTAIN",
    "cropAllowed": false,
    "minImageAreaRatio": 0
  },
  "fallbacks": []
}
