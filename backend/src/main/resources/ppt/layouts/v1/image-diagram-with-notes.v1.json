{
  "schemaVersion": "layout-recipe.v1",
  "layoutId": "image-diagram-with-notes.v1",
  "layoutVersion": "1.0.0",
  "supports": {
    "pageTypes": ["IMAGE"],
    "pagePurposes": ["PROBLEM", "METHOD", "DESIGN", "DATABASE", "IMPLEMENTATION"],
    "contentTypes": ["FIGURE", "PROCESS", "ARCHITECTURE"],
    "imageRoles": ["INFORMATION"],
    "assetKinds": ["DIAGRAM", "TECHNICAL_DRAWING"],
    "tableKinds": [],
    "assetCount": { "min": 1, "max": 1 }
  },
  "slots": {
    "title": { "gridColumn": 1, "gridSpan": 12, "topIn": 0.4, "heightIn": 0.7 },
    "image": { "gridColumn": 1, "gridSpan": 8, "topIn": 1.3, "heightIn": 5.35 },
    "body": { "gridColumn": 9, "gridSpan": 4, "topIn": 1.48, "heightIn": 3.2 },
    "caption": { "gridColumn": 9, "gridSpan": 4, "topIn": 4.95, "heightIn": 1.35 },
    "footer": { "gridColumn": 1, "gridSpan": 12, "topIn": 6.9, "heightIn": 0.2 }
  },
  "constraints": {
    "titleMaxLines": 1,
    "bodyMaxChars": 200,
    "captionMaxChars": 100,
    "imageFit": "CONTAIN",
    "cropAllowed": false,
    "minImageAreaRatio": 0.35
  },
  "fallbacks": []
}
