{
  "schemaVersion": "layout-recipe.v1",
  "layoutId": "image-centered-caption-bottom.v1",
  "layoutVersion": "1.0.0",
  "supports": {
    "pageTypes": ["IMAGE"],
    "pagePurposes": ["PROBLEM", "METHOD", "DESIGN", "DATABASE", "IMPLEMENTATION", "RESULT", "TEST"],
    "contentTypes": ["FIGURE", "METRICS", "PROCESS", "ARCHITECTURE", "MIXED"],
    "imageRoles": ["INFORMATION", "PROOF", "EFFECT"],
    "assetKinds": ["SCREENSHOT", "DIAGRAM", "CHART", "PHOTO", "TECHNICAL_DRAWING", "DESIGN_RENDER"],
    "tableKinds": [],
    "assetCount": { "min": 1, "max": 1 }
  },
  "slots": {
    "title": { "gridColumn": 1, "gridSpan": 12, "topIn": 0.4, "heightIn": 0.7 },
    "image": { "gridColumn": 1, "gridSpan": 12, "topIn": 1.2, "heightIn": 3.05 },
    "body": { "gridColumn": 1, "gridSpan": 12, "topIn": 4.4, "heightIn": 1.15 },
    "caption": { "gridColumn": 1, "gridSpan": 12, "topIn": 5.68, "heightIn": 0.98 },
    "footer": { "gridColumn": 1, "gridSpan": 12, "topIn": 6.85, "heightIn": 0.25 }
  },
  "constraints": {
    "titleMaxLines": 1,
    "bodyMaxChars": 200,
    "captionMaxChars": 150,
    "captionMaxLines": 3,
    "imageFit": "CONTAIN",
    "cropAllowed": false,
    "minImageAreaRatio": 0.12
  },
  "fallbacks": []
}
