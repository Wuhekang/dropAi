{
  "schemaVersion": "layout-recipe.v1",
  "layoutId": "image-caption-side-compact.v1",
  "layoutVersion": "1.0.0",
  "supports": {
    "pageTypes": ["IMAGE"],
    "pagePurposes": ["PROBLEM", "METHOD", "DESIGN", "DATABASE", "IMPLEMENTATION", "RESULT", "TEST"],
    "contentTypes": ["FIGURE", "METRICS", "PROCESS", "ARCHITECTURE", "MIXED"],
    "imageRoles": ["INFORMATION", "PROOF", "EFFECT"],
    "assetKinds": ["SCREENSHOT", "DIAGRAM", "CHART", "PHOTO", "TECHNICAL_DRAWING", "DESIGN_RENDER"],
    "tableKinds": [],
    "assetCount": { "min": 1, "max": 1 }
  },
  "slots": {
    "title": { "gridColumn": 1, "gridSpan": 12, "topIn": 0.4, "heightIn": 0.7 },
    "image": { "gridColumn": 1, "gridSpan": 8, "topIn": 1.28, "heightIn": 5.45 },
    "body": { "gridColumn": 9, "gridSpan": 4, "topIn": 1.42, "heightIn": 2.25 },
    "caption": { "gridColumn": 9, "gridSpan": 4, "topIn": 3.86, "heightIn": 2.5 },
    "footer": { "gridColumn": 1, "gridSpan": 12, "topIn": 6.85, "heightIn": 0.25 }
  },
  "constraints": {
    "titleMaxLines": 1,
    "bodyMaxChars": 200,
    "captionMaxChars": 150,
    "captionMaxLines": 7,
    "imageFit": "CONTAIN",
    "cropAllowed": false,
    "minImageAreaRatio": 0.25
  },
  "fallbacks": ["image-centered-caption-bottom.v1"]
}
