{
  "schemaVersion": "layout-recipe.v1",
  "layoutId": "content-text-visual-split.v1",
  "layoutVersion": "1.1.0",
  "supports": {
    "pageTypes": ["CONTENT"],
    "pagePurposes": ["METHOD", "DESIGN", "DATABASE", "IMPLEMENTATION", "RESULT", "TEST"],
    "contentTypes": ["FIGURE", "METRICS", "MIXED"],
    "imageRoles": ["INFORMATION", "PROOF", "EFFECT"],
    "assetKinds": ["SCREENSHOT", "DIAGRAM", "CHART", "PHOTO", "TECHNICAL_DRAWING", "DESIGN_RENDER", "TABLE_IMAGE"],
    "tableKinds": [],
    "assetCount": { "min": 1, "max": 1 }
  },
  "slots": {
    "title": { "gridColumn": 1, "gridSpan": 12, "topIn": 0.4, "heightIn": 0.7 },
    "body": { "gridColumn": 1, "gridSpan": 5, "topIn": 1.5, "heightIn": 4.9 },
    "image": { "gridColumn": 6, "gridSpan": 7, "topIn": 1.5, "heightIn": 4.45 },
    "caption": { "gridColumn": 6, "gridSpan": 7, "topIn": 6.05, "heightIn": 0.75 },
    "footer": { "gridColumn": 1, "gridSpan": 12, "topIn": 6.85, "heightIn": 0.25 }
  },
  "constraints": {
    "titleMaxLines": 1,
    "bodyMaxChars": 180,
    "captionMaxChars": 90,
    "imageFit": "CONTAIN",
    "cropAllowed": false,
    "minImageAreaRatio": 0.35
  },
  "fallbacks": []
}
