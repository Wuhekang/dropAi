{
  "schemaVersion": "theme.v1",
  "themeId": "bear-minimal-tan-v1",
  "themeVersion": "1.0.0",
  "inherits": [
    "academic-base@1.0.0"
  ],
  "slide": {
    "ratio": "16:9",
    "widthIn": 13.333,
    "heightIn": 7.5,
    "safeArea": {
      "leftIn": 0.58,
      "rightIn": 0.58,
      "topIn": 0.4,
      "bottomIn": 0.34
    },
    "grid": {
      "columns": 12,
      "gutterIn": 0.18
    }
  },
  "colors": {
    "surface": {
      "canvas": "#FFFFFF",
      "card": "#FFFFFF",
      "elevated": "#F7F3EF",
      "dark": "#4A4541"
    },
    "text": {
      "primary": "#202020",
      "secondary": "#4A4541",
      "inverse": "#FFFFFF"
    },
    "accent": {
      "primary": "#755B48",
      "secondary": "#D79278",
      "soft": "#F2E6DE"
    },
    "state": {
      "success": "#237A52",
      "warning": "#9A6200",
      "danger": "#B63A3A",
      "info": "#755B48"
    },
    "border": {
      "default": "#DAC7B8",
      "strong": "#AF8E76"
    }
  },
  "typography": {
    "fontPolicy": "ALLOW_DECLARED_FALLBACK",
    "fontFamilies": {
      "display": [
        "Microsoft YaHei",
        "Noto Sans CJK SC"
      ],
      "body": [
        "Microsoft YaHei",
        "Noto Sans CJK SC"
      ]
    },
    "styles": {
      "deckTitle": {
        "sizePt": 50,
        "minSizePt": 50,
        "weight": 700,
        "maxLines": 2,
        "lineSpacing": 1.08
      },
      "sectionTitle": {
        "sizePt": 40,
        "minSizePt": 40,
        "weight": 700,
        "maxLines": 1,
        "lineSpacing": 1.08
      },
      "slideTitle": {
        "sizePt": 35,
        "minSizePt": 35,
        "weight": 700,
        "maxLines": 1,
        "lineSpacing": 1.1
      },
      "subtitle": {
        "sizePt": 24,
        "minSizePt": 24,
        "weight": 500,
        "maxLines": 2,
        "lineSpacing": 1.18
      },
      "body": {
        "sizePt": 18,
        "minSizePt": 16,
        "weight": 400,
        "lineSpacing": 1.3
      },
      "bodyStrong": {
        "sizePt": 18,
        "minSizePt": 16,
        "weight": 600,
        "lineSpacing": 1.3
      },
      "caption": {
        "sizePt": 16,
        "minSizePt": 16,
        "weight": 400,
        "maxLines": 3,
        "lineSpacing": 1.24
      },
      "footnote": {
        "sizePt": 12,
        "minSizePt": 12,
        "weight": 400,
        "maxLines": 2,
        "lineSpacing": 1.2
      },
      "metric": {
        "sizePt": 30,
        "minSizePt": 26,
        "weight": 700,
        "maxLines": 1,
        "lineSpacing": 1.05
      }
    }
  },
  "spacing": {
    "xsPt": 6,
    "smPt": 10,
    "mdPt": 16,
    "lgPt": 24,
    "xlPt": 34
  },
  "shape": {
    "radiusPt": {
      "small": 4,
      "medium": 8,
      "large": 14
    },
    "borderWidthPt": {
      "thin": 0.75,
      "normal": 1.25
    }
  },
  "shadow": {
    "card": {
      "blurPt": 8,
      "distancePt": 2,
      "angleDeg": 90,
      "opacity": 0.1
    }
  },
  "components": {
    "coverTitle": {
      "textToken": "colors.text.primary",
      "accentToken": "colors.accent.secondary",
      "typographyToken": "typography.styles.deckTitle"
    },
    "sectionTitle": {
      "textToken": "colors.text.primary",
      "accentToken": "colors.accent.secondary",
      "typographyToken": "typography.styles.sectionTitle"
    },
    "slideTitle": {
      "textToken": "colors.text.primary",
      "accentToken": "colors.accent.secondary",
      "typographyToken": "typography.styles.slideTitle"
    },
    "bodyText": {
      "textToken": "colors.text.primary",
      "typographyToken": "typography.styles.body"
    },
    "keyPointCard": {
      "fillToken": "colors.surface.card",
      "textToken": "colors.text.primary",
      "accentToken": "colors.accent.primary",
      "borderToken": "colors.border.default",
      "radiusToken": "shape.radiusPt.medium",
      "shadowToken": "shadow.card",
      "typographyToken": "typography.styles.body"
    },
    "summaryCard": {
      "fillToken": "colors.accent.soft",
      "textToken": "colors.text.primary",
      "accentToken": "colors.accent.primary",
      "borderToken": "colors.border.default",
      "radiusToken": "shape.radiusPt.large",
      "typographyToken": "typography.styles.bodyStrong"
    },
    "imageFrame": {
      "fillToken": "colors.surface.card",
      "borderToken": "colors.border.strong",
      "radiusToken": "shape.radiusPt.small",
      "shadowToken": "shadow.card"
    },
    "tableHeader": {
      "fillToken": "colors.accent.soft",
      "textToken": "colors.text.primary",
      "borderToken": "colors.border.strong",
      "typographyToken": "typography.styles.bodyStrong"
    },
    "tableBody": {
      "fillToken": "colors.surface.card",
      "textToken": "colors.text.primary",
      "borderToken": "colors.border.default",
      "typographyToken": "typography.styles.body"
    },
    "caption": {
      "textToken": "colors.text.secondary",
      "typographyToken": "typography.styles.caption"
    },
    "pageNumber": {
      "textToken": "colors.text.secondary",
      "typographyToken": "typography.styles.footnote"
    }
  }
}
