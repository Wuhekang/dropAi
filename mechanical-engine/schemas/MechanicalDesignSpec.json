{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MechanicalDesignSpec",
  "type": "object",
  "required": ["product", "requirements", "functions", "architecture", "modules", "parts", "assemblyIntent", "parameters", "materials", "manufacturing"],
  "properties": {
    "product": {
      "type": "object",
      "required": ["type", "name", "purpose", "environment", "operatingPrinciple", "coreFunctions"]
    },
    "requirements": {
      "type": "object",
      "required": ["functions", "performanceGoals", "operatingConditions", "engineeringConstraints"]
    },
    "functions": { "type": "array", "minItems": 1 },
    "architecture": {
      "type": "object",
      "required": ["selectedConcept", "selectionReason", "loadPath", "motionPath"]
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "function", "interfaces", "installation"]
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["partNumber", "name", "moduleId", "function", "material", "manufacturing", "cadRequirements"],
        "properties": {
          "cadRequirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["order", "type", "intent", "parameters"],
              "properties": {
                "type": { "enum": ["SKETCH", "PAD", "POCKET", "HOLE", "FILLET", "CHAMFER"] }
              }
            }
          }
        }
      }
    },
    "assemblyIntent": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "componentA", "referenceA", "componentB", "referenceB", "purpose"]
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "value", "unit", "engineeringReason"]
      }
    },
    "materials": { "type": "array", "minItems": 1 },
    "manufacturing": { "type": "array", "minItems": 1 }
  }
}
